{
  "name": "xtier-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "ui-framework",
    "app",
    "lab"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@stratum/lab",
    "build:ui": "npm run build --workspace=@stratum/ui",
    "build:app": "npm run build --workspace=@xtier/app",
    "build:lab": "npm run build --workspace=@stratum/lab",
    "build": "npm run build:ui && npm run build:app && npm run build:lab",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test",
    "dev:app": "npm run dev --workspace=@xtier/app"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
